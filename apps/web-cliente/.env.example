# URL del admin-api que consume el navegador.
# En desarrollo local el frontend corre en 3000: dales al backend el 3001
# (PORT=3001 en services/admin-api/.env) y apunta aquí.
# En producción/Vercel define la variable en el panel del proyecto.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
