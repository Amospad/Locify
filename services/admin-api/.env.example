# Conexión a PostgreSQL (obligatoria)
DATABASE_URL="postgresql://locify:locify@localhost:5432/admin_api"

# Puerto HTTP (opcional, 3000 por defecto)
PORT=3000

# Orígenes permitidos por CORS, separados por coma.
# Vacío = sólo mismo origen. Ejemplo: http://localhost:5173,https://locify.app
CORS_ORIGINS=

# URL base del frontend para armar el enlace de invitación (opcional).
APP_URL="http://localhost:5173"

# Entorno de ejecución: development | test | production.
NODE_ENV=development

# --- JWT (obligatorio) ---
# Secreto HS256 de al menos 32 caracteres. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca lo versiones: en producción va por variables del proveedor.
JWT_SECRET=
JWT_ISSUER=locify-admin-api
JWT_AUDIENCE=locify
JWT_EXPIRES_IN=1h

# Adaptador de correo: console (imprime el enlace) | smtp (nodemailer).
# En producción use smtp: EmailConsola se niega a arrancar allí.
EMAIL_DRIVER=console

# El adaptador EmailConsola escribe el token en la consola. Se niega a
# arrancar con NODE_ENV=production salvo que se habilite explícitamente
# para una demo controlada.
EMAIL_CONSOLA_PERMITIDA=false

# --- SMTP (obligatorio con EMAIL_DRIVER=smtp) ---
# SMTP_HOST y SMTP_FROM son obligatorias. SMTP_PORT=587 usa STARTTLS;
# 465 usa TLS directo; SMTP_SECURE=true|false lo fuerza.
# SMTP_USER y SMTP_PASS van juntas o no van (SMTP local sin autenticación).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LOCIFY <no-reply@locify.app>"
SMTP_SECURE=
